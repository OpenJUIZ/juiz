cabal-version:      3.0
name:               juiz-haskell-examples
version:            0.1.0.0
synopsis:           Haskell process plugins for juiz, written with hsjuiz
license:            MIT OR Apache-2.0
author:             ysuga
build-type:         Simple

-- juiz が読み込む共有ライブラリ (Linux は lib<名前>.so、macOS は lib<名前>.dylib)。
-- juiz は Process をワーカースレッドから呼ぶので -threaded の RTS が必要
-- (-threaded でなければ juiz_hs_init がエラーを返し、読み込みが失敗する)。
-- libjuiz_sdk の場所は build.sh が --extra-lib-dirs で渡す。
--
-- Windows では lib の付かない <名前>.dll になる。Windows の GHC は Haskell の共有ライブラリ (DLL) を持たないので、
-- RTS と依存するパッケージを DLL に静的に取り込む (options: standalone)。cabal はこの指定を
-- foreign-library ごとに求める (common に書いても通らない) ので、各 foreign-library に書く。
-- 公開するシンボル (juiz が探す関数) は def/<名前>.def に並べる (mod-def-file)。
-- 書かないと、リンカがすべてのシンボルを公開しようとして DLL が公開できる数 (65535) を超えるか、
-- GHC がモジュールをアーカイブにするためにプラグインのコードが DLL に入らない (bindings/hsjuiz/README.md)。
-- また Windows では -fno-PIC を付ける。cabal は foreign-library を -fPIC でコンパイルし、Windows の -fPIC の
-- ジャンプテーブルは飛び先の差を 32 bit しか書けないので、構成子が 7 個以上の型の case や show が落ちる
-- (issue #262、GHC の不具合 https://gitlab.haskell.org/ghc/ghc/-/issues/24016)。

common plugin
    default-language: Haskell2010
    build-depends:    base >=4.18 && <5
                    , hsjuiz
    hs-source-dirs:   src
    ghc-options:      -Wall -threaded
    if os(windows)
        ghc-options:  -fno-PIC

foreign-library increment_process_hs
    import:           plugin
    type:             native-shared
    if os(windows)
        options:      standalone
        mod-def-file: def/increment_process_hs.def
    other-modules:    IncrementProcess

foreign-library decrement_process_hs
    import:           plugin
    type:             native-shared
    if os(windows)
        options:      standalone
        mod-def-file: def/decrement_process_hs.def
    other-modules:    DecrementProcess

foreign-library value_types_process_hs
    import:           plugin
    type:             native-shared
    if os(windows)
        options:      standalone
        mod-def-file: def/value_types_process_hs.def
    build-depends:    containers, text
    other-modules:    ValueTypesProcess

-- Container と ContainerProcess は別々のライブラリになる。状態の型 (ExampleContainerState) はどちらにも入れる
foreign-library example_container_hs
    import:           plugin
    type:             native-shared
    if os(windows)
        options:      standalone
        mod-def-file: def/example_container_hs.def
    other-modules:    ExampleContainer
                      ExampleContainerState

foreign-library example_container_hs_increment
    import:           plugin
    type:             native-shared
    if os(windows)
        options:      standalone
        mod-def-file: def/example_container_hs_increment.def
    other-modules:    ExampleContainerIncrement
                      ExampleContainerState

foreign-library example_container_hs_get
    import:           plugin
    type:             native-shared
    if os(windows)
        options:      standalone
        mod-def-file: def/example_container_hs_get.def
    other-modules:    ExampleContainerGet
                      ExampleContainerState

foreign-library mismatched_container_process_hs
    import:           plugin
    type:             native-shared
    if os(windows)
        options:      standalone
        mod-def-file: def/mismatched_container_process_hs.def
    other-modules:    MismatchedContainerProcess

-- Component: 1 つのライブラリに Process / Container / ContainerProcess をまとめる
foreign-library example_component_hs
    import:           plugin
    type:             native-shared
    if os(windows)
        options:      standalone
        mod-def-file: def/example_component_hs.def
    build-depends:    text
    other-modules:    ExampleComponent
                      ExampleComponentCounter

-- 誤った Component。juiz が読み込むときにエラーになる (juiz のテスト用)
foreign-library broken_component_hs
    import:           plugin
    type:             native-shared
    if os(windows)
        options:      standalone
        mod-def-file: def/broken_component_hs.def
    other-modules:    BrokenComponent

-- 型付きの引数・戻り値 (docs/spec/datatype.md §22)。gen/ の Robot.* は build.sh が juiz-idl -g haskell で
-- juiz_idl/test_package/idl/geometry.jidl から作る
foreign-library typed_component_hs
    import:           plugin
    type:             native-shared
    if os(windows)
        options:      standalone
        mod-def-file: def/typed_component_hs.def
    hs-source-dirs:   gen
    build-depends:    bytestring, containers, text
    other-modules:    TypedComponent
                      TypedOdometry
                      Robot.Common
                      Robot.Geometry

-- 画像の引数・戻り値 (docs/spec/large-data.md §10)
foreign-library image_component_hs
    import:           plugin
    type:             native-shared
    if os(windows)
        options:      standalone
        mod-def-file: def/image_component_hs.def
    build-depends:    bytestring, text
    other-modules:    ImageComponent

-- 誤った型付きの Process。juiz が読み込むときにエラーになる (juiz のテスト用)
foreign-library broken_typed_process_hs
    import:           plugin
    type:             native-shared
    if os(windows)
        options:      standalone
        mod-def-file: def/broken_typed_process_hs.def
    hs-source-dirs:   gen
    build-depends:    bytestring, containers, text
    other-modules:    BrokenTypedProcess
                      Robot.Common
                      Robot.Geometry
