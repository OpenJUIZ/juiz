; Windows で example_component_hs.dll から公開するシンボル (juiz-haskell-examples.cabal の mod-def-file)
; juiz_hs_init は hsjuiz、performMajorGC は RTS のもの (performMajorGC は juiz のテストが GC を起こすのに使う)
EXPORTS
    juiz_hs_init
    performMajorGC
    component_manifest_entry_point
    increment_manifest_entry_point
    increment_factory_entry_point
    greet_manifest_entry_point
    greet_factory_entry_point
    createCounter_manifest_entry_point
    createCounter_factory_entry_point
    createCounter_factory_destroy_entry_point
    counterGet_manifest_entry_point
    counterGet_factory_entry_point
    counterIncrement_manifest_entry_point
    counterIncrement_factory_entry_point
    example_component_hs_alive_count
