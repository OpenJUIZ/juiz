.{
    // zigjuiz (bindings/zigjuiz) で書いた Zig の例 (issue #573)。リポジトリの zigjuiz を path で使う
    .name = .juiz_zig_examples,
    .version = "0.0.0",
    .fingerprint = 0x6a31ec595103d5f2,
    .minimum_zig_version = "0.17.0",
    .dependencies = .{
        .zigjuiz = .{ .path = "../../bindings/zigjuiz" },
    },
    .paths = .{
        "build.zig",
        "build.zig.zon",
        "src",
    },
}
