[package]
name = "{{name}}"
version = "0.1.0"
edition = "2021"
description = {{description_str}}
license = "{{license}}"
publish = false

[lib]
# cdylib: the plugin juiz loads (C ABI). rlib: for cargo test
crate-type = ["cdylib", "rlib"]

[dependencies]
# Same version as the juiz that made this skeleton (juiz --version)
juiz_sdk = {{juiz_sdk_dep}}
juiz_std_types = {{juiz_std_types_dep}}  # the juiz_std types (idl: juiz_std/...)
