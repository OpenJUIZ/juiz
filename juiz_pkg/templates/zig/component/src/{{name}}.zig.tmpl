//! {{name}}: a juiz component.
//!
//! Each function is a type of juiz. juiz.exportComponent at the end lists them in one Component
//! (the shared library lib{{name}}). The arguments of a function are the fields of one struct:
//! their names, types and default values become the arguments of the type.
const std = @import("std");
const juiz = @import("juiz");

/// Returns a + b.
fn {{name}}_add(args: struct { a: i64 = 0, b: i64 = 0 }) !i64 {
    return std.math.add(i64, args.a, args.b); // error.Overflow becomes an error of the call
}

/// State of the container `{{name}}`.
const {{Name}}State = struct {
    value: i64,
};

/// Makes the state of a container `{{name}}`. initial_value comes from the entry of the container in app.conf
fn {{name}}_create(args: struct { initial_value: i64 = 0 }) {{Name}}State {
    return .{ .value = args.initial_value };
}

/// Adds step to the value and returns it.
fn {{name}}_increment(self: *{{Name}}State, args: struct { step: i64 = 1 }) !i64 {
    self.value = try std.math.add(i64, self.value, args.step);
    return self.value;
}

/// Returns the value. It takes the state as *const, so it is readonly.
fn {{name}}_get(self: *const {{Name}}State) i64 {
    return self.value;
}

comptime {
    juiz.exportComponent(.{
        .type_name = "{{name}}",
        .description = "{{name}}: a juiz component.",
        .parts = .{
            juiz.processPart({{name}}_add, .{
                .type_name = "{{name}}_add",
                .description = "Returns a + b.",
                .args = .{ .a = "first value", .b = "second value" },
            }),
            juiz.containerPart({{name}}_create, .{
                .type_name = "{{name}}",
                .description = "Holds an integer value.",
                .args = .{ .initial_value = "initial value" },
            }),
            juiz.containerProcessPart({{name}}_increment, .{
                .type_name = "{{name}}_increment",
                .container_type = "{{name}}",
                .description = "Adds step to the value and returns it.",
                .args = .{ .step = "value to add" },
            }),
            juiz.containerProcessPart({{name}}_get, .{
                .type_name = "{{name}}_get",
                .container_type = "{{name}}",
                .description = "Returns the value.",
            }),
        },
    });
}
