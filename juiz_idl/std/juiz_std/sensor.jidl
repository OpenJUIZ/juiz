// juiz の標準の型 (juiz_std): センサのデータとメタ情報
// juiz-idl に組み込まれていて、どこからでも `import idl "juiz_std/sensor.jidl";` で読める (docs/spec/datatype.md §24)。
namespace juiz_std.sensor;

import idl "common.jidl";
import idl "geometry.jidl";

/**
 * 画像のメタ情報。画素は image 型 (Capsule::Image) で別に渡し、これは引数・戻り値に並べて使う
 * (image はレコードのフィールドにできない、§3.3)
 */
record ImageInfo {
  juiz_std.common.Header header = {"stamp": {"sec": 0, "nanosec": 0}, "frame_id": ""};
  /** 幅 [px] */
  int width = 0;
  /** 高さ [px] */
  int height = 0;
  /** 画素の並び ("rgb8"・"rgba8"・"mono8"・"bgr8" など。ROS 2 の sensor_msgs/Image の encoding と同じ名前) */
  string encoding = "rgb8";
}

/** 慣性計測装置 (IMU) の値 */
record Imu {
  juiz_std.common.Header header = {"stamp": {"sec": 0, "nanosec": 0}, "frame_id": ""};
  /** 姿勢 */
  juiz_std.geometry.Quaternion orientation = {"x": 0.0, "y": 0.0, "z": 0.0, "w": 1.0};
  /** 角速度 [rad/s] */
  juiz_std.geometry.Vector3 angular_velocity = {"x": 0.0, "y": 0.0, "z": 0.0};
  /** 加速度 [m/s^2] */
  juiz_std.geometry.Vector3 linear_acceleration = {"x": 0.0, "y": 0.0, "z": 0.0};
}

/** 平面を走査する測距センサ (LiDAR など) の値 */
record LaserScan {
  juiz_std.common.Header header = {"stamp": {"sec": 0, "nanosec": 0}, "frame_id": ""};
  /** 最初の測定の角度 [rad] */
  float angle_min = 0.0;
  /** 最後の測定の角度 [rad] */
  float angle_max = 0.0;
  /** 測定の間の角度 [rad] */
  float angle_increment = 0.0;
  /** 測れる最短の距離 [m] */
  float range_min = 0.0;
  /** 測れる最長の距離 [m] */
  float range_max = 0.0;
  /** 距離 [m]。範囲外は range_min〜range_max の外の値 */
  array<float> ranges = [];
}

/** 距離センサ (超音波・赤外線など) の値 */
record Range {
  juiz_std.common.Header header = {"stamp": {"sec": 0, "nanosec": 0}, "frame_id": ""};
  /** 距離 [m] */
  float range = 0.0;
  /** 測れる最短の距離 [m] */
  float min_range = 0.0;
  /** 測れる最長の距離 [m] */
  float max_range = 0.0;
}
