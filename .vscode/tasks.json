{
  // CI(.github/workflows/test.yml)と同じ手順でビルド・テストするタスク。
  // devcontainer の外でも動くように PYO3_PYTHON と PYTHONPATH を設定している。
  "version": "2.0.0",
  "options": {
    "env": {
      "PYO3_PYTHON": "python3",
      "PYTHONPATH": "${workspaceFolder}/bindings/pyjuiz",
      "RUST_BACKTRACE": "1"
    }
  },
  "tasks": [
    {
      "label": "cargo build",
      "type": "shell",
      "command": "cargo build",
      "problemMatcher": ["$rustc"],
      "group": { "kind": "build", "isDefault": true }
    },
    {
      "label": "cmake build (C++ examples)",
      "type": "shell",
      "command": "cmake -S examples/cpp -B examples/cpp/build -DCMAKE_BUILD_TYPE=Debug && cmake --build examples/cpp/build --parallel",
      "problemMatcher": ["$gcc"],
      "group": "build"
    },
    {
      "label": "build all",
      "dependsOn": ["cargo build", "cmake build (C++ examples)"],
      "dependsOrder": "sequence",
      "problemMatcher": [],
      "group": "build"
    },
    {
      // scripts/test.sh が例のビルドと Python パッケージの確認を済ませてから
      // cargo test -- --test-threads=1 を実行する(CI と同じスクリプト)。
      "label": "cargo test",
      "type": "shell",
      "command": "scripts/test.sh",
      "problemMatcher": ["$rustc"],
      "group": { "kind": "test", "isDefault": true }
    },
    {
      "label": "cargo clippy",
      "type": "shell",
      "command": "cargo clippy --all-targets",
      "problemMatcher": ["$rustc"]
    },
    {
      "label": "cargo fmt",
      "type": "shell",
      "command": "cargo fmt --all",
      "problemMatcher": []
    }
  ]
}
